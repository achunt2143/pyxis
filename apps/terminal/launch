#!/bin/sh
# Placeholder launch script for the Terminal app.
#
# Real shells (Pyxis) embed Terminal as an in-process React component for now;
# this script exists so the AppHost can `spawn()` a process whose PID
# represents the Terminal session and feed lifecycle signals back to the bus.
#
# Future work: replace with a true PTY bridge that connects to gecko-shell.

echo "[terminal] starting (pid=$$)"
trap 'echo "[terminal] SIGTERM"; exit 0' TERM
trap 'echo "[terminal] SIGUSR1 (raise)"' USR1

# Sleep forever; the real surface is owned by the shell side.
while :; do
    sleep 60 &
    wait $!
done
