#!/bin/sh
# Placeholder launch script for the Contacts app.
#
# Contacts is a standalone Bloom page (contacts.html) — a separate document/process
# from the shell. Until the pyxis-webapp kiosk can launch it as a real
# Wayland client, this script exists so the AppHost can `spawn()` a process
# whose PID represents the Contacts session and feed lifecycle signals back to
# the bus (same pattern as apps/terminal/launch).

echo "[contacts] starting (pid=$$)"
trap 'echo "[contacts] SIGTERM"; exit 0' TERM
trap 'echo "[contacts] SIGUSR1 (raise)"' USR1

# Sleep forever; the real surface is owned by the shell side.
while :; do
    sleep 60 &
    wait $!
done
