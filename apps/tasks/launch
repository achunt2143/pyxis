#!/bin/sh
# Placeholder launch script for the Tasks app.
#
# Tasks is a standalone Bloom page (tasks.html) — a separate document/process
# from the shell. Until the pyxis-webapp kiosk can launch it as a real
# Wayland client, this script exists so the AppHost can `spawn()` a process
# whose PID represents the Tasks session and feed lifecycle signals back to
# the bus (same pattern as apps/terminal/launch).

echo "[tasks] starting (pid=$$)"
trap 'echo "[tasks] SIGTERM"; exit 0' TERM
trap 'echo "[tasks] SIGUSR1 (raise)"' USR1

# Sleep forever; the real surface is owned by the shell side.
while :; do
    sleep 60 &
    wait $!
done
