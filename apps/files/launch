#!/bin/sh
# Placeholder launch script for the Files app. See apps/terminal/launch
# for a description of why this is a long-running shell stub.

echo "[files] starting (pid=$$)"
trap 'echo "[files] SIGTERM"; exit 0' TERM
trap 'echo "[files] SIGUSR1 (raise)"' USR1

while :; do
    sleep 60 &
    wait $!
done
