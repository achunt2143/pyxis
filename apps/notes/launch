#!/bin/sh
# Placeholder launch script for the Notes app.
#
# Notes is a standalone Bloom page (notes.html) — a separate document/process
# from the shell. Until the pyxis-webapp kiosk can launch it as a real
# Wayland client, this script exists so the AppHost can `spawn()` a process
# whose PID represents the Notes session and feed lifecycle signals back to
# the bus (same pattern as apps/terminal/launch).

echo "[notes] starting (pid=$$)"
trap 'echo "[notes] SIGTERM"; exit 0' TERM
trap 'echo "[notes] SIGUSR1 (raise)"' USR1

# Sleep forever; the real surface is owned by the shell side.
while :; do
    sleep 60 &
    wait $!
done
