// GeckoOS Filesystem API
// Provides access to the filesystem on the system

interface FilesystemEntry {
  name: string;
  path: string;
  isDirectory: boolean;
  size: number;
  mimeType: string;
  modified: number; // milliseconds since epoch
}

interface DirectoryResult {
  path: string;
  entries: FilesystemEntry[];
  totalCount: number;
}

interface Filesystem {
  // List contents of a directory
  getDirectoryDetails(path: string): Promise<DirectoryResult>;

  // Get info about a single file/directory
  getFileInfo(path: string): Promise<FilesystemEntry>;

  // Read entire text file
  readTextFile(path: string): Promise<string>;

  // Delete a file or directory
  deleteEntry(path: string): Promise<void>;

  // Create a new directory
  createDirectory(parentPath: string, dirName: string): Promise<string>;
}