Rebrand add-on blocklist installation error dialog strings from Mozilla policy wording to Pyxis.

════════════════════════════════════════════════════════════════════════
The unified diff below is generated from the checkout and is applied with
  git apply gecko/patches/pyxis/<path>.PYXIS_DIFF
(or `patch -p1 <`). Everything above this line is rationale, not content;
git apply ignores it. Regenerate with scripts/regen-gecko-patches.sh.
════════════════════════════════════════════════════════════════════════

diff --git a/browser/locales/en-US/browser/addonNotifications.ftl b/browser/locales/en-US/browser/addonNotifications.ftl
index 9b8530330ee4..b201cabff633 100644
--- a/browser/locales/en-US/browser/addonNotifications.ftl
+++ b/browser/locales/en-US/browser/addonNotifications.ftl
@@ -131,7 +131,7 @@ addon-local-install-error-not-signed = This add-on could not be installed becaus
 # Variables:
 #   $appVersion (String): the application version.
 addon-install-error-incompatible = { $addonName } could not be installed because it is not compatible with { -brand-short-name } { $appVersion }.
-addon-install-error-hard-blocked = { $addonName } violates Mozilla’s policies and can’t be installed on { -brand-short-name }.
-addon-install-error-soft-blocked = { $addonName } violates Mozilla’s policies and can’t be installed on { -brand-short-name }.
+addon-install-error-hard-blocked = { $addonName } violates Pyxis’s policies and can’t be installed on { -brand-short-name }.
+addon-install-error-soft-blocked = { $addonName } violates Pyxis’s policies and can’t be installed on { -brand-short-name }.
 # Enterprise policies is a feature aimed at system administrators who want to deploy custom settings for Firefox.
 addon-install-error-admin-install-only = You cannot install { $addonName } as an end user, it can only be installed by an organization using enterprise policies.
