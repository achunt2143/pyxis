{
  "name": "geckoOS",
  "version": "0.1.0",
  "description": "Firefox Gecko-based desktop operating system",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild static/scripts/app.js --bundle --outfile=dist/app.js --external:fs --external:path",
    "build:css": "postcss static/styles/*.css --dir dist/css",
    "dev": "concurrently \"npm run watch:js\" \"npm run watch:css\" \"cargo watch -x build\"",
    "watch:js": "esbuild static/scripts/app.js --bundle --outfile=dist/app.js --watch --external:fs --external:path",
    "watch:css": "postcss static/styles/*.css --dir dist/css --watch",
    "lint": "eslint static/scripts/ --fix",
    "format": "prettier --write \"static/**/*.{js,css,html}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist node_modules",
    "clean:dist": "rm -rf dist"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "classnames": "^2.3.2",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.8",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.32",
    "postcss-cli": "^10.1.0",
    "postcss-nested": "^6.0.1",
    "postcss-preset-env": "^9.1.1",
    "prettier": "^3.1.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}