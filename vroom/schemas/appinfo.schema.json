{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyxis.dev/schemas/appinfo.schema.json",
  "title": "Pyxis App Manifest",
  "type": "object",
  "required": ["id", "version", "vendor", "title", "type", "main", "icon"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9_-]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][A-Za-z0-9]+)?$"
    },
    "vendor": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["web", "native"]
    },
    "main": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "largeIcon": {
      "type": "string"
    },
    "bgImage": {
      "type": "string"
    },
    "splashBackground": {
      "type": "string"
    },
    "appDescription": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "uiRevision": {
      "type": "integer",
      "minimum": 1
    },
    "category": {
      "type": "string"
    },
    "fullscreen": {
      "type": "boolean"
    },
    "requiredPermissions": {
      "type": "array",
      "description": "Declared app permissions (spec §19.1). `notifications.manage`, `appmanager.install`, `appmanager.manage`, `settings.write`, `windows.manage`, `terminal`, `filesystem.user`, `filesystem.system` and `filesystem.apps` are privileged: declaring them is always valid, but Nova grants the corresponding capability only to apps on the platform trust list (spec §19.2).",
      "items": {
        "type": "string",
        "enum": [
          "network",
          "notifications",
          "camera",
          "microphone",
          "location",
          "bluetooth",
          "filesystem.read",
          "filesystem.write",
          "ipc",
          "background",
          "power",
          "audio",
          "browser",
          "notifications.manage",
          "appmanager.install",
          "appmanager.manage",
          "settings.write",
          "windows.manage",
          "terminal",
          "filesystem.user",
          "filesystem.system",
          "filesystem.apps"
        ]
      },
      "uniqueItems": true
    },
    "window": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "resizable": { "type": "boolean" },
        "frame": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "entryArgs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9_-]+)*$"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "web" } }
      },
      "then": {
        "properties": {
          "main": {
            "pattern": "^(?!/).+"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "native" } }
      },
      "then": {
        "properties": {
          "main": {
            "pattern": "^/.+"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
