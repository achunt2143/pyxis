[Unit]
Description=KRATOS Performance Optimization
Documentation=man:kratos(1)
After=cronus.service

[Service]
Type=simple
ExecStart=/opt/geckoOS/bin/kratos
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kratos
User=root
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target