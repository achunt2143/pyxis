# Reference systemd unit (GeckoOS currently boots via BusyBox /sbin/init ->
# /usr/sbin/geckoOS-boot, generated by scripts/create-rootfs.sh).
#
# echo-daemon must run as root (NOT User=geckouser): its in-process services
# require root privileges for accounts (/etc/shadow reads and chpasswd),
# installer (opkg install/remove into system paths), scoped filesystem calls
# (/var/lib/pyxis/data creation/chown and per-thread setuid/setgid drops to
# geckouser or per-app UIDs), nova/pyxis-wlctx, power, network, and terminal.
# Because it binds $XDG_RUNTIME_DIR/geckoOS/echo.sock as root, boot hands
# socket/directory ownership to geckouser (1000:1000) so unprivileged clients
# (vela/apps) can connect.
[Unit]
Description=ECHO IPC Manager (DBus)
Documentation=man:echo(1)
After=shift.service
Requires=shift.service
Before=evo.service

[Service]
Type=simple
ExecStart=/usr/bin/echo-daemon
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=echo
User=root
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket"

[Install]
WantedBy=multi-user.target