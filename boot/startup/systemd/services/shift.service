[Unit]
Description=SHIFT Process Manager
Documentation=man:shift(1)
After=syslog.target

[Service]
Type=simple
ExecStart=/usr/bin/shift-daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shift
User=root
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target