[Unit]
Description=EVO Wayland Compositor
Documentation=man:evo(1)
After=echo.service shift.service
Requires=echo.service

[Service]
Type=simple
ExecStart=/usr/bin/evo
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=evo
User=geckouser
Group=geckouser
Environment="DISPLAY=:0"
Environment="WAYLAND_DISPLAY=wayland-0"
Environment="XDG_RUNTIME_DIR=/run/user/1000"

[Install]
WantedBy=multi-user.target