CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_USB_MIXER_QUIRKS=y
CONFIG_SND_USB_CAIAQ=y
CONFIG_SND_USB_US122L=y
CONFIG_SND_USB_USX2Y=y
CONFIG_SND_USB_USBPN=y

# ============================================================================
# NETWORKING - Basic (localhost required)
# ============================================================================
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_DUMMY=y
CONFIG_LOOPBACK_TARGET=y
CONFIG_NET_CORE=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_TCP_TIMESTAMPS=y
CONFIG_IPVS=n

# IPv4
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ROUTE_MULTICAST=y
CONFIG_SYN_COOKIES=y
CONFIG_INET_DIAG=y

# IPv6 (minimal)
