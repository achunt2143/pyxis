CONFIG_GENERIC_CALIBRATE_DELAY=y
CONFIG_CPU_RELAX_DEFAULT=y
CONFIG_HAVE_LE_GS=y
CONFIG_HAVE_IDE=y
CONFIG_HAVE_EFFICIENT_UNALIGNED_ACCESS=y
