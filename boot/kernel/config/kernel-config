CONFIG_NETFILTER=n

# ============================================================================
# KERNEL MODULES
# ============================================================================
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=n
CONFIG_MODVERSIONS=n
CONFIG_MODULE_SRCVERSION_ALL=n

# ============================================================================
# DEVICE SUPPORT
# ============================================================================
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DEV_APPLETALK=n
CONFIG_HAVE_GPIO_DEVICE=y
CONFIG_GPIO_SUPPORT=y
CONFIG_GPIOLIB=y
