# GeckoOS Linux Kernel Configuration
# Minimal but complete configuration for Firefox-based desktop OS
# Optimized for: Graphics (DRM/KMS), Input (libinput), Audio (ALSA)
# This file is used as: .config when compiling Linux kernel

# ============================================================================
# KERNEL VERSION AND BUILD OPTIONS
# ============================================================================
CONFIG_LOCALVERSION="-geckoOS"
CONFIG_LOCALVERSION_AUTO=n

# ============================================================================
# GENERAL SETUP
# ============================================================================
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_HAVE_UNSTABLE_SCHED_CLOCK=y

# ============================================================================
# CPU SUPPORT - Multi-core Systems
# ============================================================================
CONFIG_SMP=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_NR_CPUS=128
CONFIG_PREEMPT_NONE=y
CONFIG_CPUFREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_LADDER=y
CONFIG_CPU_IDLE_GOV_MENU=y

# ============================================================================
# POWER MANAGEMENT
# ============================================================================
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=n
CONFIG_PM_RUNTIME=y
CONFIG_ACPI=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_FAN=y

# ============================================================================
# ARCHITECTURE
# ============================================================================
CONFIG_X86=y
CONFIG_X86_64=y
CONFIG_ARCH_HWEIGHT_CMPXCHG64=y
CONFIG_HAVE_EFFICIENT_UNALIGNED_ACCESS=y

# ============================================================================
# MEMORY MANAGEMENT
# ============================================================================
CONFIG_PAGE_OFFSET=0xffff880000000000
CONFIG_FLATMEM=y
CONFIG_FLAT_NODE_MAP=y
CONFIG_SPARSEMEM_VMEMMAP=y
CONFIG_HAVE_MEMORYLESS_NODES=y
CONFIG_HAVE_MEMORY_PRESENT=y
CONFIG_HAVE_FAST_GUP=y
CONFIG_ZONE_DMA=y
CONFIG_ZONE_DMA32=y
CONFIG_ZONE_NORMAL=y
CONFIG_ZONE_DEVICE=y
CONFIG_HAVE_BOOTMEM_INFO_NODE=y
CONFIG_SPLIT_PTLOCK_CPUS=4
CONFIG_MIGRATION=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_SWAP=y
CONFIG_ZSWAP=n
CONFIG_KASAN=n

# ============================================================================
# FILESYSTEMS - Essential
# ============================================================================
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT4_DEBUG=n
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_INODE64=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEBUGFS=y
CONFIG_SECURITYFS=y

# ============================================================================
# GRAPHICS & DISPLAY (DRM/KMS)
# ============================================================================
CONFIG_DRM=y
CONFIG_DRM_LOAD_EDID=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_DRM_GEM_CMA_HELPER=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_KMS_FB_HELPER=y
CONFIG_DRM_SCHED=y

# Intel GPU Support (i915)
CONFIG_DRM_I915=y
CONFIG_DRM_I915_COMPRESS_GPU_TLB=y
CONFIG_DRM_I915_FORCE_PROBE=""
CONFIG_DRM_I915_USERPTR=y
CONFIG_DRM_I915_GVT=n

# AMD GPU Support (AMDGPU)
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_AMDGPU_SRIOV_VF=n

# NVIDIA Support (Nouveau - open source)
CONFIG_DRM_NOUVEAU=y
CONFIG_DRM_NOUVEAU_FIRMWARE_LOADING=y
CONFIG_DRM_NOUVEAU_BACKLIGHT=y

# Generic GPU Support
CONFIG_DRM_TTM=y
CONFIG_DRM_BUDDY=y
CONFIG_DRM_VRAM_HELPER=y
CONFIG_DRM_GEM_SHMEM_HELPER=y

# Framebuffer & Console
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_FB_TILE=y
CONFIG_FB_NOTIFY=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
CONFIG_VGA_SWITCHEROO=y
CONFIG_BACKLIGHT_LCD_SUPPORT=y
CONFIG_LCD_CLASS_DEVICE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# ============================================================================
# INPUT DEVICES & LIBINPUT
# ============================================================================
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_MOUSEDEV_PSAUX=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_BATTERY=y
CONFIG_USB_HID=y
CONFIG_HID_SUPPORT=y
CONFIG_I8042_NOKBD=n
CONFIG_I8042_NOMUX=n

# ============================================================================
# USB SUPPORT
# ============================================================================
CONFIG_USB=y
CONFIG_USB_DEFAULT_PERSIST=y
CONFIG_USB_DYNAMIC_MINORS=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_COMMON=y
CONFIG_USBDEVFS_FS=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_HID=y

# ============================================================================
# AUDIO - ALSA
# ============================================================================
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCM=y
CONFIG_SND_SEQUENCER=n
CONFIG_SND_JACK=y
CONFIG_SND_JACK_INPUT_DEVICE=y
CONFIG_SND_OSSEMUL=y
CONFIG_SND_MIXER_OSS=y
CONFIG_SND_PCM_OSS=y

# ALSA Support
CONFIG_SND_HDA=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_PREALLOC_SIZE=64
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_CODEC_VIA=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_CA0110=y
CONFIG_SND_HDA_CODEC_CA0132=y
CONFIG_SND_HDA_CODEC_CMEDIA=y
CONFIG_SND_HDA_CODEC_CIRCUSLOGIC=y
