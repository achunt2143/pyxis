CONFIG_KGDB=n
CONFIG_PROVE_LOCKING=n
CONFIG_DEBUG_BUGVERBOSE=y
CONFIG_DEBUG_RODATA_TEST=n
CONFIG_MAGIC_SYSRQ=y
CONFIG_HAVE_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK=n

# ============================================================================
