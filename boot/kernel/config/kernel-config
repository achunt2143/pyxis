CONFIG_HAVE_NMI_WATCHDOG=y
CONFIG_HAVE_KRETPROBES=y
CONFIG_HAVE_FUNCTION_TRACER=y
CONFIG_HAVE_FUNCTION_GRAPH_TRACER=y
CONFIG_HAVE_SYSCALL_TRACEPOINTS=y
